# ============================================================
# Quizmefy — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Server -----------------------------------------------
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ----- Database (PostgreSQL) --------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://quizmefy:quizmefy_password@localhost:5432/quizmefy_db

# ----- Redis ------------------------------------------------
# Leave blank to use in-memory NodeCache fallback
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600

# ----- JWT Auth ---------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# ----- AI Providers -----------------------------------------
# Primary provider: "openai" or "anthropic"
AI_PROVIDER=openai

# OpenAI
# Comma-separate multiple keys for rotation: key1,key2,key3
OPENAI_API_KEYS=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# Anthropic (Claude)
# Comma-separate multiple keys for rotation: key1,key2,key3
ANTHROPIC_API_KEYS=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048

# ----- Rate Limiting ----------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX=20

# ----- CORS -------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ----- AWS (for CI/CD — set in GitHub Secrets, not here) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# ECR_REPOSITORY=your-ecr-repo-uri
# ECS_CLUSTER=quizmefy-cluster
# ECS_SERVICE=quizmefy-api
# S3_FRONTEND_BUCKET=your-s3-bucket-name
# CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
